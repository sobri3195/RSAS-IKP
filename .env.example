# Server only. Never prefix credentials or keys with VITE_.
DATABASE_URL=postgresql://rsas_app:replace_securely@localhost:5432/rsas
# For remote PostgreSQL, require sslmode=verify-full and the provider's trusted CA.
APP_ORIGIN=http://localhost:5173
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Store in a secret manager, keep an offline recovery copy, never commit the value.
DATA_ENCRYPTION_KEY=
ALLOW_ATTACHMENTS=false
PUBLIC_REPORTS_PER_HOUR=120
API_PORT=3001
